# Dirección pública del sitio, con https y sin barra final. Canónicas, sitemap
# y datos estructurados salen de aquí. Ej.: https://www.tudominio.es
NEXT_PUBLIC_SITE_URL=

# Copiar los nombres y rellenar los valores EN VERCEL > Settings > Environment Variables.
# No necesitas crear .env.local. No subas claves reales a GitHub.
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Supabase > Settings > API Keys: service_role (legacy) o secret key de servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Datos comerciales. Número internacional sin + ni espacios.
NOTIFICATION_EMAIL=
WHATSAPP_NUMBER=
# true para avisos reales; false guarda solicitudes sin enviar avisos.
LIVE_INQUIRIES=false
# Necesaria con LIVE_INQUIRIES=true: el correo es el único registro de cada
# solicitud (Resend). NOTIFICATION_EMAIL debe ser el correo de tu cuenta de
# Resend mientras no verifiques un dominio.
RESEND_API_KEY=
# Opcional: sin ella se envía desde onboarding@resend.dev.
FROM_EMAIL=
