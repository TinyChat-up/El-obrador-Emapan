# Copiar los nombres y rellenar los valores EN VERCEL > Settings > Environment Variables.
# No necesitas crear .env.local. No subas claves reales a GitHub.
# Supabase > Connect > Transaction pooler (puerto 6543). Copia la URI exacta.
# Codifica los caracteres especiales de la contraseña para una URL.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Supabase > Settings > API Keys: service_role (legacy) o secret key de servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Datos comerciales. Número internacional sin + ni espacios.
NOTIFICATION_EMAIL=
WHATSAPP_NUMBER=
# true para avisos reales; false guarda solicitudes sin enviar avisos.
LIVE_INQUIRIES=false
# Opcionales: necesarios para avisos por correo automáticos (Resend).
RESEND_API_KEY=
FROM_EMAIL=

# Opcionales: avisos automáticos por WhatsApp (WhatsApp Cloud API de Meta).
# Si faltan, la web funciona igual y solo envía el aviso por correo.
# Meta > WhatsApp > API Setup: Phone number ID del remitente.
WHATSAPP_PHONE_ID=
# Token permanente de un usuario de sistema con permiso whatsapp_business_messaging.
WHATSAPP_TOKEN=
# Tu número personal, que recibe los avisos. Internacional, sin + ni espacios.
WHATSAPP_TO=
# Plantilla de utilidad aprobada y su idioma. Estos son los valores por defecto.
WHATSAPP_TEMPLATE=aviso_solicitud
WHATSAPP_TEMPLATE_LANG=es
